# Mẫu cấu hình. Sao chép thành .env rồi điền giá trị THẬT (file .env không bao giờ được commit).
# Trên VPS, deploy/install.sh tự sinh /opt/qlcontainer/.env với mật khẩu và khóa ngẫu nhiên.

# Kết nối PostgreSQL bằng user riêng của ứng dụng (không dùng tài khoản postgres)
DATABASE_URL=postgresql+psycopg://qlcontainer_app:DOI_MAT_KHAU_CSDL@127.0.0.1:5432/qlcontainer

# Khóa bí mật >= 32 ký tự để băm HMAC token phiên. Sinh bằng:  openssl rand -hex 32
SECRET_KEY=thay_bang_chuoi_ngau_nhien_it_nhat_32_ky_tu

# Thời gian sống của phiên đăng nhập (giờ)
SESSION_HOURS=8

# true khi chạy sau HTTPS (cookie chỉ gửi qua kết nối mã hóa)
COOKIE_SECURE=false

# Bật trang tài liệu API /api/docs (chỉ nên bật khi demo)
DOCS_ENABLED=false

# Chỉ dùng khi chạy thử trên máy cá nhân: để FastAPI tự phục vụ thư mục frontend
SERVE_FRONTEND=false
